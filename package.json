{
  "name": "lumist-trial-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm test && npm run typecheck && npm run build",
    "teachers:preview": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs",
    "teachers:sync": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --apply",
    "teachers:preview-new": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --new-only",
    "teachers:sync-new": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --new-only --apply",
    "teachers:preview-qr": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --qr-only",
    "teachers:sync-qr": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --qr-only --apply",
    "teachers:reset-passwords": "node --env-file-if-exists=.env.local scripts/sync-feishu-teachers.mjs --apply --reset-passwords"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "15.5.21",
    "openai": "^6.48.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}
